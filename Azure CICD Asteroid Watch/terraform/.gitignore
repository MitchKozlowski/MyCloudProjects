# Local Terraform working files - regenerated by `terraform init`
.terraform/
.terraform.lock.hcl

# State files - contain resource details and, in our case, the NASA API
# key in plaintext. NEVER commit these. (In a team setting, state would
# live in a remote backend like Azure Storage instead of local files -
# we'll touch on that as a possible enhancement later.)
*.tfstate
*.tfstate.*

# Your real variable values, including the API key
terraform.tfvars

# Crash logs, if Terraform ever produces one
crash.log
